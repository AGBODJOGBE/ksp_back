{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.request.reactivation_requested.v1.schema.json",
  "title": "cleaning.request.reactivation_requested",
  "description": "Réactivation d’un devis expiré demandée (R-AC-04). Écouté par notification (superviseur).",
  "x-event-type": "cleaning.request.reactivation_requested",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "requestNumber", "customerId", "organizationId", "communeKey", "requestedAt"],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "requestNumber": {
      "type": "string",
      "minLength": 1
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Compte du client (titulaire ou auteur de la demande)"
    },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente ; null pour un particulier"
    },
    "communeKey": {
      "type": "string",
      "minLength": 1,
      "description": "Commune du lieu, pour joindre le superviseur de la zone"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
