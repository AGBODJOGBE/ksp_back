{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.session.interrupted.v1.schema.json",
  "title": "cleaning.session.interrupted",
  "description": "Séance interrompue par un incident (partie 10). Écouté par notification (superviseur).",
  "x-event-type": "cleaning.session.interrupted",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "programId",
    "customerId",
    "organizationId",
    "programNumber",
    "rank",
    "sessionsCount",
    "communeKey",
    "incidentId",
    "category",
    "interruptedAt"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "programId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Compte du client (titulaire ou auteur de la demande)"
    },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente ; null pour un particulier"
    },
    "programNumber": {
      "type": "string",
      "minLength": 1,
      "description": "PN-000057"
    },
    "rank": {
      "type": "integer",
      "minimum": 1,
      "description": "Rang de la séance"
    },
    "sessionsCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Nombre de séances du programme"
    },
    "communeKey": {
      "type": "string",
      "minLength": 1,
      "description": "Commune du lieu, pour joindre le superviseur de la zone"
    },
    "incidentId": {
      "type": "string",
      "format": "uuid"
    },
    "category": {
      "enum": ["equipment", "access", "safety", "out_of_scope_request", "other"]
    },
    "interruptedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
