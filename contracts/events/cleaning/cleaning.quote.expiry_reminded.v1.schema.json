{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.quote.expiry_reminded.v1.schema.json",
  "title": "cleaning.quote.expiry_reminded",
  "description": "Rappel avant l’expiration d’un devis envoyé (R-DV-04, UC-NT-44). Écouté par notification (client).",
  "x-event-type": "cleaning.quote.expiry_reminded",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quoteId",
    "requestId",
    "requestNumber",
    "customerId",
    "organizationId",
    "total",
    "validUntil",
    "reminderDays",
    "remindedAt"
  ],
  "properties": {
    "quoteId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "requestNumber": {
      "type": "string",
      "minLength": 1
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Compte du client (titulaire ou auteur de la demande)"
    },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente ; null pour un particulier"
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "XOF"
        }
      }
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "reminderDays": {
      "type": "integer",
      "minimum": 1
    },
    "remindedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
