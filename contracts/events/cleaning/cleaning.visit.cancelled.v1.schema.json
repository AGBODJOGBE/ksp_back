{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.visit.cancelled.v1.schema.json",
  "title": "cleaning.visit.cancelled",
  "description": "Visite annulée (R-VI-06). Publié si la visite n’était pas encore passée. Écouté par notification (client, agents).",
  "x-event-type": "cleaning.visit.cancelled",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visitId",
    "requestId",
    "requestNumber",
    "customerId",
    "organizationId",
    "communeKey",
    "releasedAgentIds",
    "scheduledAt",
    "cause",
    "visitFeeRefund",
    "cancelledAt"
  ],
  "properties": {
    "visitId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "requestNumber": {
      "type": "string",
      "minLength": 1
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Compte du client (titulaire ou auteur de la demande)"
    },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente ; null pour un particulier"
    },
    "communeKey": {
      "type": "string",
      "minLength": 1,
      "description": "Commune du lieu, pour joindre le superviseur de la zone"
    },
    "releasedAgentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Agents libérés"
    },
    "scheduledAt": {
      "type": "string",
      "format": "date-time"
    },
    "cause": {
      "enum": ["request_cancelled", "request_rejected", "slot_changed", "ksp", "agent_no_show"]
    },
    "visitFeeRefund": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "const": "XOF"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "null : rien de remboursé"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
