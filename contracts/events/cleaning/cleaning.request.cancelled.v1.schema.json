{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.request.cancelled.v1.schema.json",
  "title": "cleaning.request.cancelled",
  "description": "Demande annulée par le client (UC-NT-10) ou par le système, frais de visite non payés sous 72 h (R-FV-03, UC-NT-44).",
  "x-event-type": "cleaning.request.cancelled",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "requestNumber",
    "customerId",
    "organizationId",
    "cause",
    "visitFeeRefund",
    "cancelledAt"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "requestNumber": {
      "type": "string",
      "minLength": 1
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Compte du client (titulaire ou auteur de la demande)"
    },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente ; null pour un particulier"
    },
    "cause": {
      "enum": ["customer", "visit_fee_unpaid"]
    },
    "visitFeeRefund": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "const": "XOF"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Frais remboursés au wallet (R-FV-06) ; null : rien à rembourser"
    },
    "cancelledAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
