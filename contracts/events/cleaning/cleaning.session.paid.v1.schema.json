{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.session.paid.v1.schema.json",
  "title": "cleaning.session.paid",
  "description": "Séance d’un particulier payée par débit du wallet (R-PP-01, R-WL-05).",
  "x-event-type": "cleaning.session.paid",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "programId",
    "customerId",
    "organizationId",
    "amountPaid",
    "visitFeeDeduction",
    "walletTransactionId",
    "invoiceId",
    "paidAt",
    "programNumber",
    "rank",
    "sessionsCount"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "programId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Compte du client (titulaire ou auteur de la demande)"
    },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente ; null pour un particulier"
    },
    "amountPaid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "XOF"
        }
      }
    },
    "visitFeeDeduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "XOF"
        }
      }
    },
    "walletTransactionId": {
      "type": "string",
      "format": "uuid"
    },
    "invoiceId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Facture de séance (billing), si déjà émise"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    },
    "programNumber": {
      "type": "string",
      "minLength": 1,
      "description": "PN-000057"
    },
    "rank": {
      "type": "integer",
      "minimum": 1,
      "description": "Rang de la séance"
    },
    "sessionsCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Nombre de séances du programme"
    }
  }
}
