{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.intervention.unscheduled.v1.schema.json",
  "title": "cleaning.intervention.unscheduled",
  "description": "Un passage planifié est annulé par la supervision pour être replanifié (ADR-053) : la mission a de nouveau un passage à planifier, sans effet sur l'argent. Le motif reste dans cleaning, jamais dans l'événement.",
  "x-event-type": "cleaning.intervention.unscheduled",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["missionId", "interventionId", "customerId", "previousStart", "releasedAgentIds"],
  "properties": {
    "missionId": { "type": "string", "format": "uuid" },
    "interventionId": { "type": "string", "format": "uuid" },
    "customerId": { "type": "string", "format": "uuid" },
    "previousStart": { "type": "string", "format": "date-time" },
    "releasedAgentIds": {
      "type": "array",
      "description": "Agents libérés du passage",
      "items": { "type": "string", "format": "uuid" }
    },
    "serviceCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Facultatif : prestation de la mission"
    },
    "serviceName": {
      "type": "string",
      "minLength": 1,
      "description": "Facultatif : nom de la prestation au moment de l'événement"
    },
    "groupId": {
      "type": "string",
      "format": "uuid",
      "description": "Facultatif : groupe des demandes créées ensemble pour un même lieu"
    }
  }
}
