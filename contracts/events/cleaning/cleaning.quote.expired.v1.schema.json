{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.quote.expired.v1.schema.json",
  "title": "cleaning.quote.expired",
  "description": "Devis sans réponse à sa date de validité (R-AC-04, UC-NT-44).",
  "x-event-type": "cleaning.quote.expired",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quoteId",
    "requestId",
    "customerId",
    "organizationId",
    "validUntil",
    "expiredAt",
    "requestNumber",
    "communeKey",
    "total",
    "placeTypeName",
    "cleaningTypeNames"
  ],
  "properties": {
    "quoteId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Compte du client (titulaire ou auteur de la demande)"
    },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente ; null pour un particulier"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "expiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestNumber": {
      "type": "string",
      "minLength": 1
    },
    "communeKey": {
      "type": "string",
      "minLength": 1,
      "description": "Commune du lieu, pour joindre le superviseur de la zone"
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "XOF"
        }
      }
    },
    "placeTypeName": {
      "type": "string",
      "minLength": 1,
      "description": "Nom du lieu en vigueur"
    },
    "cleaningTypeNames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Noms des types en vigueur, dans l’ordre de la demande"
    }
  }
}
