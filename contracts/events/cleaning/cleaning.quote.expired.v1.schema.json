{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.quote.expired.v1.schema.json",
  "title": "cleaning.quote.expired",
  "description": "Devis arrivés au terme de leur validité sans réponse du client (ADR-053) : la tâche planifiée de cleaning enregistre leur expiration. Un événement par client et par groupe de demandes (ou par demande seule) traités ensemble, pour un seul message.",
  "x-event-type": "cleaning.quote.expired",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["customerId", "organizationId", "quotes", "expiredAt"],
  "properties": {
    "customerId": { "type": "string", "format": "uuid" },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente, null pour un particulier"
    },
    "groupId": {
      "type": "string",
      "format": "uuid",
      "description": "Facultatif : groupe des demandes créées ensemble pour un même lieu (ADR-034)"
    },
    "quotes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "Devis expirés, un par demande",
      "items": { "$ref": "#/$defs/quoteRef" }
    },
    "expiredAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "quoteRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "quoteId", "serviceCode", "total", "validUntil"],
      "properties": {
        "requestId": { "type": "string", "format": "uuid" },
        "quoteId": { "type": "string", "format": "uuid" },
        "serviceCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "serviceName": {
          "type": "string",
          "minLength": 1,
          "description": "Nom de la prestation au moment de l'événement ; absent si la prestation n'existe plus"
        },
        "total": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "integer", "minimum": 0 },
            "currency": { "const": "XOF" }
          }
        },
        "validUntil": { "type": "string", "format": "date-time" }
      }
    }
  }
}
