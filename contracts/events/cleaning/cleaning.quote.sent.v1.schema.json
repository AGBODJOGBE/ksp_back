{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.quote.sent.v1.schema.json",
  "title": "cleaning.quote.sent",
  "description": "Devis envoyé ou révisé (UC-NT-33, R-DV-05, R-DV-06). Écouté par notification.",
  "x-event-type": "cleaning.quote.sent",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quoteId",
    "requestId",
    "requestNumber",
    "customerId",
    "organizationId",
    "kind",
    "version",
    "sessionPrice",
    "sessionsCount",
    "total",
    "visitFeeDeduction",
    "validUntil",
    "sentAt",
    "placeTypeName",
    "cleaningTypeNames"
  ],
  "properties": {
    "quoteId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "requestNumber": {
      "type": "string",
      "minLength": 1
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Compte du client (titulaire ou auteur de la demande)"
    },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente ; null pour un particulier"
    },
    "kind": {
      "enum": ["initial", "amendment", "renewal", "reorder"]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Révision"
    },
    "sessionPrice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "XOF"
        }
      }
    },
    "sessionsCount": {
      "type": "integer",
      "minimum": 1
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "XOF"
        }
      }
    },
    "visitFeeDeduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "XOF"
        }
      }
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time"
    },
    "placeTypeName": {
      "type": "string",
      "minLength": 1,
      "description": "Nom du lieu en vigueur"
    },
    "cleaningTypeNames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Noms des types en vigueur, dans l’ordre de la demande"
    }
  }
}
