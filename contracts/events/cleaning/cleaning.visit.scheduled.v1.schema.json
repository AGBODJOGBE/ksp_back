{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/cleaning/cleaning.visit.scheduled.v1.schema.json",
  "title": "cleaning.visit.scheduled",
  "description": "Visite planifiée ou déplacée (UC-NT-31, R-VI-03). Écouté par notification (client, agent).",
  "x-event-type": "cleaning.visit.scheduled",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visitId",
    "requestId",
    "requestNumber",
    "customerId",
    "organizationId",
    "agentIds",
    "scheduledAt",
    "durationMinutes",
    "previousScheduledAt",
    "releasedAgentIds",
    "placeTypeName",
    "cleaningTypeNames"
  ],
  "properties": {
    "visitId": {
      "type": "string",
      "format": "uuid"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "requestNumber": {
      "type": "string",
      "minLength": 1
    },
    "customerId": {
      "type": "string",
      "format": "uuid",
      "description": "Compte du client (titulaire ou auteur de la demande)"
    },
    "organizationId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Organisation cliente ; null pour un particulier"
    },
    "agentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Agents de la visite"
    },
    "scheduledAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 15
    },
    "previousScheduledAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Date précédente pour un déplacement ; null pour une première planification"
    },
    "releasedAgentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Agents retirés par ce changement ; vide sinon"
    },
    "placeTypeName": {
      "type": "string",
      "minLength": 1,
      "description": "Nom du lieu en vigueur"
    },
    "cleaningTypeNames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Noms des types en vigueur, dans l’ordre de la demande"
    }
  }
}
