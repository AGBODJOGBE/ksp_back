{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ksp.bj/events/recovery/recovery.plan.installment_missed.v1.schema.json",
  "title": "recovery.plan.installment_missed",
  "description": "Échéance non payée à la fin du délai de grâce (6.1). Identifiants et montants seulement : ni nom, ni téléphone, ni adresse du débiteur (ADR-060).",
  "x-event-type": "recovery.plan.installment_missed",
  "x-event-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "caseNumber",
    "creditor",
    "planId",
    "installmentRank",
    "dueDate",
    "amount",
    "missedCount",
    "missedAt"
  ],
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "XOF"
        }
      }
    },
    "creditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "description": "Créancier titulaire du dossier : un compte ou une organisation (identifiants seulement)",
      "properties": {
        "type": {
          "enum": ["user", "organization"]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  },
  "properties": {
    "caseId": {
      "type": "string",
      "format": "uuid"
    },
    "caseNumber": {
      "type": "string",
      "pattern": "^RC-[0-9]{6,}$",
      "description": "Numéro lisible du dossier"
    },
    "creditor": {
      "$ref": "#/$defs/creditor"
    },
    "planId": {
      "type": "string",
      "format": "uuid"
    },
    "installmentRank": {
      "type": "integer",
      "minimum": 1
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "$ref": "#/$defs/money"
    },
    "missedCount": {
      "type": "integer",
      "minimum": 1
    },
    "missedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
