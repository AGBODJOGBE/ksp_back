# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=__name__
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=__GRPC_PORT__
HTTP_PORT=__HTTP_PORT__
DATABASE_URL=postgresql://__db_name__:__db_name__@localhost:5432/__db_name__
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
