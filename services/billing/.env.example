# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=billing
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50054
HTTP_PORT=3104
DATABASE_URL=postgresql://billing:billing@localhost:5432/billing
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
# Facturation planifiée (millisecondes, 0 pour la désactiver).
BILLING_SCHEDULER_INTERVAL_MS=900000
# En-tête des factures d'organisation : fiche lue dans identity à l'émission (GetOrganizationsByIds).
IDENTITY_GRPC_URL=localhost:50051
# Jeton de service vers identity (ADR-022), obligatoire en production ; vide en local sans vérification.
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
