# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=notification
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50052
HTTP_PORT=3102
DATABASE_URL=postgresql://notification:notification@localhost:5432/notification
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
# Avec cette adresse, seuls identity et document peuvent appeler SendNotification.
IDENTITY_JWKS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prestataire WhatsApp (ADR-021) :
#   console : le code est écrit dans le terminal du service, aucun message ne part (développement uniquement ;
#             le service refuse de démarrer avec console quand NODE_ENV=production) ;
#   meta    : WhatsApp Cloud API de Meta (valeur par défaut en production).
NOTIFICATION_WHATSAPP_PROVIDER=console
# Avec meta uniquement. Le jeton et l'identifiant du numéro viennent du coffre à secrets, jamais de ce fichier.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_OTP_TEMPLATE=ksp_otp
# WHATSAPP_TEMPLATE_LANGUAGE=fr
# Délai maximum d'un appel à Meta (identity attend notification 3 secondes au plus).
# WHATSAPP_TIMEOUT_MS=2000

# Prestataire e-mail (ADR-024) :
#   console : l'e-mail est écrit dans le terminal (adresse masquée), aucun envoi (développement uniquement ;
#             le service refuse de démarrer avec console quand NODE_ENV=production) ;
#   brevo   : API transactionnelle de Brevo (valeur par défaut en production).
NOTIFICATION_EMAIL_PROVIDER=console
# Avec brevo uniquement. La clé vient du coffre à secrets, jamais de ce fichier ; l'adresse est sur un domaine vérifié.
# BREVO_API_KEY=
# EMAIL_SENDER_ADDRESS=notifications@ksp.bj
# EMAIL_SENDER_NAME=Groupe KSP
# EMAIL_TIMEOUT_MS=5000

# Destinataires des événements métier : coordonnées lues dans identity (GetUsersByIds).
IDENTITY_GRPC_URL=localhost:50051
# Jeton de service vers identity (ADR-022), obligatoire en production ; vide en local sans vérification.
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=
# Liens des messages vers « Mon espace KSP » (adresse HTTPS publique obligatoire en production),
# et fuseau des dates écrites.
PORTAL_BASE_URL=http://localhost:3010
NOTIFICATION_TIME_ZONE=Africa/Porto-Novo
# Comptes de l'équipe Nettoyage (admin, superviseurs) prévenus de la reprise après impayés et des
# passages à replanifier à la main : identifiants séparés par des virgules ; vide = personne.
NOTIFICATION_CLEANING_TEAM_USER_IDS=
