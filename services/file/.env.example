# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=file
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50056
HTTP_PORT=3106
DATABASE_URL=postgresql://file:file@localhost:5432/file
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Stockage compatible S3 (ADR-038) : MinIO de docker-compose en local (identifiants de développement
# uniquement) ; en production, Object Storage de Contabo, clés fournies par le coffre.
FILE_STORAGE_ENDPOINT=http://localhost:9000
# Adresse inscrite dans les adresses présignées si les fronts joignent le stockage autrement (HTTPS en production).
FILE_STORAGE_PUBLIC_ENDPOINT=
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=ksp-files
FILE_STORAGE_ACCESS_KEY=ksp
FILE_STORAGE_SECRET_KEY=ksp-local-secret
FILE_STORAGE_FORCE_PATH_STYLE=true
# Développement : crée le bucket au démarrage s'il manque (interdit en production).
FILE_STORAGE_CREATE_BUCKET=true
# Validité des adresses d'envoi et de lecture (secondes).
FILE_UPLOAD_URL_TTL_SECONDS=900
FILE_DOWNLOAD_URL_TTL_SECONDS=300
# Purge : envoi non confirmé (minutes), fichier jamais rattaché (heures), grâce avant effacement physique (heures).
FILE_PENDING_TTL_MINUTES=1440
FILE_UNATTACHED_TTL_HOURS=24
FILE_ERASE_DELAY_HOURS=168
# Quota par compte : envois en attente simultanés, volume déclaré sur 24 heures (Mo).
FILE_MAX_PENDING_PER_OWNER=20
FILE_DAILY_UPLOAD_MB=500
# Intervalle de la purge (ms, 0 : désactivée).
FILE_PURGE_INTERVAL_MS=600000
