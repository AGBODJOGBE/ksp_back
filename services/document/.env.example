# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=document
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50058
HTTP_PORT=3108
DATABASE_URL=postgresql://document:document@localhost:5432/document
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
# Jeton de service (ADR-022) pour appeler file, notification et identity (obligatoire en production).
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Services appelés (ADR-044) : stockage des PDF, envoi des codes et liens, comptes des signataires.
FILE_GRPC_URL=localhost:50056
NOTIFICATION_GRPC_URL=localhost:50052
IDENTITY_GRPC_URL=localhost:50051
# Clé du HMAC des codes de signature (32 caractères au moins ; coffre à secrets en production).
DOCUMENT_CODE_HMAC_SECRET=dev-only-document-code-hmac-secret-0123456789
# Adresse de « Mon espace KSP » pour les liens de signature (HTTPS en production).
PORTAL_BASE_URL=http://localhost:4200
DOCUMENT_TIME_ZONE=Africa/Porto-Novo
# Émetteur imprimé sur les documents ; mentions légales (RCCM, IFU) à renseigner avant la production.
DOCUMENT_ISSUER_NAME=Groupe KSP
DOCUMENT_ISSUER_ADDRESS=Cotonou, Bénin
DOCUMENT_ISSUER_LEGAL_DETAILS=
# Modèle de test « generic » (vide : ouvert hors production, interdit en production).
DOCUMENT_GENERIC_TEMPLATE_ENABLED=
# Services autorisés à produire des documents et à demander des signatures.
DOCUMENT_INTERNAL_CALLERS=recovery,cleaning,billing
# Codes de signature : validité (s), essais, délai entre deux envois (s), envois par heure.
DOCUMENT_CODE_TTL_SECONDS=600
DOCUMENT_CODE_MAX_ATTEMPTS=5
DOCUMENT_CODE_RESEND_DELAY_SECONDS=60
DOCUMENT_CODE_MAX_PER_HOUR=5
# Clôture des demandes expirées (ms, 0 : désactivée) ; délai d'envoi ou de lecture d'un PDF (ms).
DOCUMENT_EXPIRY_INTERVAL_MS=600000
DOCUMENT_TRANSFER_TIMEOUT_MS=15000
