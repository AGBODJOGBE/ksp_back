# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=geo
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50059
HTTP_PORT=3109
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
# Géocodage inverse (ADR-034, ADR-045), facultatif : Nominatim auto-hébergé d'abord, Google Maps
# Geocoding en secours (clé dans le coffre, jamais ici). Vides : aucune commune n'est trouvée.
NOMINATIM_URL=
GOOGLE_MAPS_API_KEY=
GEOCODING_TIMEOUT_MS=3000
# Cache en mémoire des résultats trouvés (secondes, 0 pour le désactiver ; nombre d'entrées).
GEOCODING_CACHE_TTL_SECONDS=3600
GEOCODING_CACHE_MAX_ENTRIES=5000
# Itinéraires : osrm-routed (docker compose --profile routing up -d osrm, après tools/geo/prepare-osrm).
# Vide ou injoignable : GEO_ROUTING_UNAVAILABLE, le géocodage reste servi.
OSRM_URL=http://localhost:5000
OSRM_TIMEOUT_MS=2000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
