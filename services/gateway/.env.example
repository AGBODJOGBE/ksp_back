# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=gateway
NODE_ENV=development
LOG_LEVEL=debug
HTTP_PORT=3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# identity lancé en local (gRPC 50051, HTTP interne 3101).
IDENTITY_GRPC_URL=localhost:50051
IDENTITY_JWKS_URL=http://localhost:3101/.well-known/jwks.json
# Jeton de service de la gateway (ADR-022) : vide en local, les appels vers identity ne sont pas
# authentifiés (avertissement au démarrage). Obligatoire en production.
#   pnpm --filter @ksp/identity-service keys:service-client gateway identity
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=

# Origines autorisées (CORS), qui fixent aussi le type de client : sites web et back-office.
# Une requête sans origine avec l'en-tête X-App-Version est une application mobile.
# Ports des fronts en développement : portail 3010, shop 3020, print 3030, back-office 3040.
CORS_WEB_ORIGINS=http://localhost:3010,http://localhost:3020,http://localhost:3030
CORS_BACKOFFICE_ORIGINS=http://localhost:3040
# Mandataires de confiance pour l'adresse IP du client (obligatoire en production, réseau de Traefik).
TRUST_PROXY=loopback
# Cookie de renouvellement sans Secure : seulement pour un front servi en HTTP hors localhost.
# REFRESH_COOKIE_INSECURE=false

# Valeurs par défaut du cahier des charges Gateway (partie 4) :
# GRPC_DEADLINE_MS=3000
# MAX_BODY_BYTES=1048576
# JWKS_CACHE_TTL_SECONDS=600
# JWKS_RELOAD_COOLDOWN_SECONDS=30
# RATE_LIMIT_PUBLIC_PER_MINUTE=60
# RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
# RATE_LIMIT_OTP_REQUEST_PER_MINUTE=5
# RATE_LIMIT_OTP_VERIFY_PER_MINUTE=10
# RATE_LIMIT_REFRESH_PER_MINUTE=60
