# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=gateway
NODE_ENV=development
LOG_LEVEL=debug
HTTP_PORT=3000
# Port interne, jamais exposé : sondes de santé et métriques (ADR-051).
INTERNAL_HTTP_PORT=3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# identity lancé en local (gRPC 50051, HTTP interne 3101).
IDENTITY_GRPC_URL=localhost:50051
IDENTITY_JWKS_URL=http://localhost:3101/.well-known/jwks.json
# Jeton de service de la gateway (ADR-022) : vide en local, les appels vers identity ne sont pas
# authentifiés (avertissement au démarrage). Obligatoire en production.
#   pnpm --filter @ksp/identity-service keys:service-client gateway identity
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=

# cleaning lancé en local (gRPC 50053) : routes /api/v1/cleaning et /api/v1/admin/cleaning.
CLEANING_GRPC_URL=localhost:50053
# billing lancé en local (gRPC 50054) : routes /api/v1/billing et /api/v1/admin/billing.
BILLING_GRPC_URL=localhost:50054
# Paiement en ligne Mobile Money (ADR-031).
PAYMENT_GRPC_URL=localhost:50055
NOTIFICATION_GRPC_URL=localhost:50052
# Stockage des fichiers (ADR-038).
FILE_GRPC_URL=localhost:50056
WALLET_GRPC_URL=localhost:50057
# Documents et signature par code (ADR-044).
DOCUMENT_GRPC_URL=localhost:50058

# Origines autorisées (CORS), qui fixent aussi le type de client : sites web et back-office.
# Une requête sans origine avec l'en-tête X-App-Version est une application mobile.
# Ports des fronts en développement : portail 3010, shop 3020, print 3030, back-office 3040.
CORS_WEB_ORIGINS=http://localhost:3010,http://localhost:3020,http://localhost:3030
CORS_BACKOFFICE_ORIGINS=http://localhost:3040
# Mandataires de confiance pour l'adresse IP du client (obligatoire en production, réseau de Traefik).
TRUST_PROXY=loopback
# Cookie de renouvellement sans Secure : seulement pour un front servi en HTTP hors localhost.
# REFRESH_COOKIE_INSECURE=false

# Valeurs par défaut du cahier des charges Gateway (partie 4) :
# GRPC_DEADLINE_MS=3000
# MAX_BODY_BYTES=1048576
# JWKS_CACHE_TTL_SECONDS=600
# JWKS_RELOAD_COOLDOWN_SECONDS=30
# RATE_LIMIT_PUBLIC_PER_MINUTE=60
# RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
# Routes connectées, par adresse IP, avant la vérification du jeton :
# RATE_LIMIT_AUTHENTICATED_IP_PER_MINUTE=1200
# RATE_LIMIT_OTP_REQUEST_PER_MINUTE=5
# RATE_LIMIT_OTP_VERIFY_PER_MINUTE=10
# RATE_LIMIT_MFA_VERIFY_PER_MINUTE=10
# RATE_LIMIT_REFRESH_PER_MINUTE=60
# Simulateur public du Nettoyage (cahier des charges Nettoyage, partie 5) :
# RATE_LIMIT_CLEANING_SIMULATION_PER_MINUTE=20
# Position du lieu d’intervention (géocodage, ADR-034), par utilisateur :
# RATE_LIMIT_CLEANING_GEOCODING_PER_MINUTE=10
# Code de confirmation de l'e-mail du profil, par utilisateur :
# RATE_LIMIT_EMAIL_CODE_REQUEST_PER_MINUTE=3
# RATE_LIMIT_EMAIL_CODE_VERIFY_PER_MINUTE=10
# Recherche de compte par téléphone au back-office, par utilisateur :
# RATE_LIMIT_ACCOUNT_LOOKUP_PER_MINUTE=20
# RATE_LIMIT_PAYMENT_CREATE_PER_MINUTE=10
# RATE_LIMIT_PAYMENT_WEBHOOK_PER_MINUTE=120
# RATE_LIMIT_PAYMENT_LINK_READ_PER_MINUTE=30
# RATE_LIMIT_PAYMENT_LINK_PAY_PER_MINUTE=5
# RATE_LIMIT_FILE_UPLOAD_PER_MINUTE=30
# RATE_LIMIT_DOCUMENT_CODE_REQUEST_PER_MINUTE=3
# RATE_LIMIT_DOCUMENT_CODE_VERIFY_PER_MINUTE=10
# RATE_LIMIT_DOCUMENT_LINK_PER_MINUTE=30
# RATE_LIMIT_DOCUMENT_LINK_CODE_REQUEST_PER_MINUTE=3
# RATE_LIMIT_DOCUMENT_LINK_CODE_VERIFY_PER_MINUTE=10
