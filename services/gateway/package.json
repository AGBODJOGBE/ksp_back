{
  "name": "@ksp/gateway-service",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway de l'écosystème KSP : seule porte d'entrée REST des fronts, traduite en gRPC vers les services.",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "dev": "node --watch --env-file=.env -r ../../tools/dev/register.cjs -r ./src/tracing.ts src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@ksp/contracts": "workspace:*",
    "@ksp/platform": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/microservices": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "jose": "5.10.0",
    "nestjs-pino": "4.6.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "supertest": "7.3.1",
    "yaml": "2.9.1"
  }
}
