# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=cleaning
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50053
HTTP_PORT=3103
DATABASE_URL=postgresql://cleaning:cleaning@localhost:5432/cleaning
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
# Photos et pièces des dossiers : service file (FileInternalService, ADR-038).
FILE_GRPC_URL=localhost:50056
# Noms affichés au back-office : lus dans identity (GetUsersByIds, GetOrganizationsByIds, ADR-029).
IDENTITY_GRPC_URL=localhost:50051
# Wallet du client (ADR-046) : débits et remboursements.
WALLET_GRPC_URL=localhost:50057
# Jeton de service vers identity (ADR-022), obligatoire en production ; vide en local sans vérification.
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=
# Service geo (ADR-045, ADR-059) : commune par contour, adresse lisible, temps de trajet.
GEO_GRPC_URL=localhost:50059
# Délai d'un fournisseur de géocodage chez geo ; l'appel à geo dure au plus 2 × ce délai + 1 s.
GEOCODING_TIMEOUT_MS=3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Lot E : facture de séance (billing.IssueInvoice) et paiement direct Mobile Money (payment).
BILLING_GRPC_URL=localhost:50054
PAYMENT_GRPC_URL=localhost:50055
# Lot E : intervalle des tâches (retards, couverture, rappels, factures, reprise des débits) ; 0 : désactivées.
CLEANING_EXECUTION_TASKS_INTERVAL_MS=60000
