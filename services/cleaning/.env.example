# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=cleaning
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50053
HTTP_PORT=3103
DATABASE_URL=postgresql://cleaning:cleaning@localhost:5432/cleaning
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
# Surveillance des passages impayés des particuliers (millisecondes, 0 pour la désactiver).
CLEANING_PAYMENT_WATCH_INTERVAL_MS=3600000
# Noms affichés au back-office : lus dans identity (GetUsersByIds, GetOrganizationsByIds, ADR-029).
IDENTITY_GRPC_URL=localhost:50051
# Jeton de service vers identity (ADR-022), obligatoire en production ; vide en local sans vérification.
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=
# Contrôles de dates du terrain (proposition à valider) : true ou false.
CLEANING_TIME_ZONE=Africa/Porto-Novo
CLEANING_BLOCK_EARLY_INTERVENTION_START=true
CLEANING_BLOCK_EARLY_VISIT_REPORT=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
