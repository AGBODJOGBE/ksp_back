# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=cleaning
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50053
HTTP_PORT=3103
DATABASE_URL=postgresql://cleaning:cleaning@localhost:5432/cleaning
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
# Surveillance des passages impayés des particuliers (millisecondes, 0 pour la désactiver).
CLEANING_PAYMENT_WATCH_INTERVAL_MS=3600000
# Purge des positions GPS des dossiers clôturés (ADR-035 ; millisecondes, 0 pour la désactiver).
CLEANING_LOCATION_PURGE_INTERVAL_MS=21600000
# Échéances des demandes : devis expirés, rappels, visites des demandes closes (ADR-053 ; millisecondes,
# 0 pour la désactiver).
CLEANING_REQUEST_DEADLINES_INTERVAL_MS=600000
# Photos des passages : service file (FileInternalService, ADR-038, ADR-053).
FILE_GRPC_URL=localhost:50056
# Noms affichés au back-office : lus dans identity (GetUsersByIds, GetOrganizationsByIds, ADR-029).
IDENTITY_GRPC_URL=localhost:50051
# Portefeuille prépayé des clients (ADR-046) : paiement d'une mission par le portefeuille.
WALLET_GRPC_URL=localhost:50057
# Jeton de service vers identity (ADR-022), obligatoire en production ; vide en local sans vérification.
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=
# Contrôles de dates du terrain (proposition à valider) : true ou false.
CLEANING_TIME_ZONE=Africa/Porto-Novo
CLEANING_BLOCK_EARLY_INTERVENTION_START=true
CLEANING_BLOCK_EARLY_VISIT_REPORT=true
# Géocodage inverse par le service geo (ADR-045) : renseignée, les trois variables suivantes ne
# servent plus (jeton de service d'audience geo en production).
GEO_GRPC_URL=localhost:50059
# Repli sans GEO_GRPC_URL (ADR-034) : Nominatim auto-hébergé d'abord, Google Maps Geocoding en
# secours (clé dans le coffre, jamais ici). Tout vide : le client choisit sa commune.
NOMINATIM_URL=
GOOGLE_MAPS_API_KEY=
GEOCODING_TIMEOUT_MS=3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
