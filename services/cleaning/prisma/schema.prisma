// Base de données du service cleaning. Aucun autre service n'y accède (règle d'or n° 1).
// Montants en entiers de FCFA (XOF). Les coordonnées du client restent dans identity ;
// seule l'adresse d'intervention, propre au dossier, est gardée ici.

generator client {
  provider = "prisma-client-js"
  // Client propre à ce service : plusieurs services cohabitent dans le dépôt.
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Événements à publier (pattern outbox, règle d'or n° 4). Écrits dans la même transaction que la donnée métier.
model OutboxEvent {
  id            String    @id @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  /// Prochaine tentative après un échec (délai croissant, ADR-032).
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  /// Mis de côté après 24 h d'échecs : rejouable par pnpm outbox:replay (ADR-032).
  parkedAt      DateTime? @map("parked_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  /// Premier échec de publication : mise de côté après 24 h d'échecs (ADR-032).
  firstFailedAt DateTime? @map("first_failed_at") @db.Timestamptz(3)

  @@map("outbox")
}

/// Événements déjà traités par ce service (inbox) : un événement reçu deux fois n'a qu'un effet.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, consumer])
  @@map("processed_events")
}

/// Prestation du catalogue (UC-CL-11).
model CleaningService {
  code        String        @id
  name        String
  description String        @default("")
  /// Déprécié (ADR-033) : unité de l'ancien formulaire, déduite du champ de la taille d'équipe
  /// (square_meter, room, septic_tank, cubic_meter).
  unit        String
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  pricing     PricingRule[]

  @@map("cleaning_services")
}

/// Grille tarifaire versionnée : chaque modification crée une ligne, avec son auteur et sa date.
model PricingRule {
  id                   String          @id @db.Uuid
  serviceCode          String          @map("service_code")
  version              Int
  /// Déprécié (ADR-033) : prix par unité du champ de la taille d'équipe, déduit.
  unitPrice            Int?            @map("unit_price")
  minimumPrice         Int?            @map("minimum_price")
  options              Json            @default("[]")
  communeCoefficients  Json            @default("{}") @map("commune_coefficients")
  defaultCoefficientBp Int             @default(10000) @map("default_coefficient_bp")
  teamSize             Json            @map("team_size")
  checklist            Json            @default("[]")
  /// Champs du formulaire, dans l'ordre d'affichage (ADR-033).
  fields               Json            @default("[]")
  /// Options et leurs champs (ADR-033). L'ancienne colonne options garde les forfaits, déduits.
  optionDefinitions    Json            @default("[]") @map("option_definitions")
  /// Fréquences propres à la prestation (ADR-033).
  frequencies          Json            @default("[]")
  createdBy            String          @map("created_by")
  createdAt            DateTime        @map("created_at") @db.Timestamptz(3)
  service              CleaningService @relation(fields: [serviceCode], references: [code])

  @@unique([serviceCode, version])
  @@map("pricing_rules")
}

/// Réglages de la partie 4 du cahier des charges (une seule ligne, id = 1).
model CleaningSettings {
  id                                      Int       @id @default(1)
  quoteValidityDays                       Int       @default(15) @map("quote_validity_days")
  minimumLeadHours                        Int       @default(48) @map("minimum_lead_hours")
  freeCancellationHours                   Int       @default(24) @map("free_cancellation_hours")
  visitThresholdSquareMeters              Int       @default(300) @map("visit_threshold_square_meters")
  maxOpenRequests                         Int       @default(5) @map("max_open_requests")
  depositPercent                          Int       @default(30) @map("deposit_percent")
  /// Règles d'impayés (partie 10 du cahier des charges).
  businessWarningUnpaidInvoices           Int       @default(1) @map("business_warning_unpaid_invoices")
  businessSuspensionUnpaidInvoices        Int       @default(2) @map("business_suspension_unpaid_invoices")
  individualSuspensionUnpaidInterventions Int       @default(1) @map("individual_suspension_unpaid_interventions")
  individualPaymentGraceHours             Int       @default(24) @map("individual_payment_grace_hours")
  /// Mois de conservation de la position des demandes et missions clôturées (ADR-035).
  locationRetentionMonths                 Int       @default(12) @map("location_retention_months")
  updatedBy                               String?   @map("updated_by")
  updatedAt                               DateTime? @map("updated_at") @db.Timestamptz(3)

  @@map("cleaning_settings")
}

/// Demande de devis (UC-CL-02 à 08).
model QuoteRequest {
  id                  String             @id @db.Uuid
  customerId          String             @map("customer_id") @db.Uuid
  idempotencyKey      String             @map("idempotency_key")
  status              String
  customerKind        String             @map("customer_kind")
  organizationId      String?            @map("organization_id") @db.Uuid
  serviceCode         String             @map("service_code")
  premisesType        String             @map("premises_type")
  quantity            Int
  options             String[]
  commune             String
  /// Code de zone de la commune saisie (minuscules, sans accents, tirets) : filtre du back-office.
  communeCode         String             @map("commune_code")
  /// Adresse d'intervention : jamais dans les journaux ni dans les événements.
  address             String
  preferredSlots      Json               @map("preferred_slots")
  comment             String?
  recurrence          Json?
  requestedTeamSize   Int                @default(0) @map("requested_team_size")
  /// Entreprise : jours d'intervention par semaine, null si non précisés.
  daysPerWeek         Int?               @map("days_per_week")
  recommendedTeamSize Int                @map("recommended_team_size")
  estimateLow         Int?               @map("estimate_low")
  estimateHigh        Int?               @map("estimate_high")
  currentQuoteId      String?            @map("current_quote_id") @db.Uuid
  missionId           String?            @map("mission_id") @db.Uuid
  closingReason       String?            @map("closing_reason")
  /// Réponses au formulaire (ADR-033), null pour une demande antérieure.
  answers             Json?
  /// Options choisies avec leurs réponses.
  optionSelections    Json               @default("[]") @map("option_selections")
  frequency           String?
  /// Version de la grille du calcul, null pour une demande antérieure.
  pricingVersion      Int?               @map("pricing_version")
  /// Détail du calcul au moment de la demande, null pour une demande antérieure.
  calculation         Json?
  /// Groupe des demandes créées ensemble pour un même lieu (ADR-034), null pour une demande seule.
  groupId             String?            @map("group_id") @db.Uuid
  /// Type de lieu choisi par le client (ADR-034).
  placeType           String?            @map("place_type")
  /// Position GPS du lieu (ADR-034) : jamais dans les journaux ni dans les événements.
  latitude            Float?
  longitude           Float?
  locationAccuracyM   Float?             @map("location_accuracy_m")
  /// Point de repère donné par le client (ADR-034).
  landmark            String?
  /// Fournisseur qui a trouvé la commune (nominatim, google), null si choisie par le client.
  geocodingProvider   String?            @map("geocoding_provider")
  /// Adresse lisible rendue par le géocodeur pour la position (ADR-034).
  geocodedAddress     String?            @map("geocoded_address")
  /// Mesures constatées après la visite (ADR-037), null sans mesure ; les réponses du client restent.
  measuredAnswers     Json?              @map("measured_answers")
  measuredOptions     Json?              @map("measured_option_selections")
  measuredFrequency   String?            @map("measured_frequency")
  /// Calcul des mesures : grille en vigueur et commune de la demande au moment de la saisie.
  measuredCalculation Json?              @map("measured_calculation")
  measuredVersion     Int?               @map("measured_pricing_version")
  measuredAt          DateTime?          @map("measured_at") @db.Timestamptz(3)
  measuredBy          String?            @map("measured_by") @db.Uuid
  createdAt           DateTime           @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @map("updated_at") @db.Timestamptz(3)
  /// Contrôle de concurrence optimiste.
  version             Int                @default(0)
  visit               SiteVisit?
  quotes              Quote[]
  group               QuoteRequestGroup? @relation(fields: [groupId], references: [id])

  @@unique([customerId, idempotencyKey])
  @@index([customerId, id])
  @@index([status, id])
  @@index([communeCode, id])
  @@index([groupId])
  @@index([status, updatedAt])
  @@map("quote_requests")
}

/// Groupe de demandes créées ensemble pour un même lieu, une par prestation (ADR-034).
/// Idempotent par (client, clé) : le rejeu d'une même clé rend le même groupe.
model QuoteRequestGroup {
  id             String         @id @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  idempotencyKey String         @map("idempotency_key")
  placeType      String         @map("place_type")
  /// Commune retenue : trouvée par géocodage, ou choisie par le client en repli.
  commune        String
  createdAt      DateTime       @map("created_at") @db.Timestamptz(3)
  requests       QuoteRequest[]

  @@unique([customerId, idempotencyKey])
  @@map("quote_request_groups")
}

/// Type de lieu du parcours client (ADR-034), géré au back-office ; jamais supprimé (active = false).
model PlaceType {
  code         String    @id
  label        String
  description  String    @default("")
  /// Nom d'icône libre, interprété par le front.
  icon         String
  displayOrder Int       @default(0) @map("display_order")
  active       Boolean   @default(true)
  /// Codes des prestations proposées, dans l'ordre d'affichage.
  serviceCodes String[]  @default([]) @map("service_codes")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy    String?   @map("updated_by")
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(3)

  @@map("place_types")
}

/// Visite technique (UC-CL-07) ; une replanification garde la même ligne.
model SiteVisit {
  id           String       @id @db.Uuid
  requestId    String       @unique @map("request_id") @db.Uuid
  status       String
  scheduledAt  DateTime     @map("scheduled_at") @db.Timestamptz(3)
  agentId      String       @map("agent_id") @db.Uuid
  report       String?
  completedAt  DateTime?    @map("completed_at") @db.Timestamptz(3)
  /// Visite commune à plusieurs demandes d'un groupe (ADR-035), null pour une visite seule.
  groupVisitId String?      @map("group_visit_id") @db.Uuid
  request      QuoteRequest @relation(fields: [requestId], references: [id])

  @@index([groupVisitId])
  @@index([agentId, scheduledAt])
  @@map("site_visits")
}

/// Devis envoyé : prix figé, un devis révisé s'ajoute sans effacer le précédent.
model Quote {
  id                String       @id @db.Uuid
  requestId         String       @map("request_id") @db.Uuid
  lines             Json
  subtotal          Int
  interventionCount Int          @map("intervention_count")
  total             Int
  proposedSlots     Json         @map("proposed_slots")
  validUntil        DateTime     @map("valid_until") @db.Timestamptz(3)
  depositPercent    Int          @map("deposit_percent")
  depositAmount     Int          @map("deposit_amount")
  recurrence        Json?
  teamSize          Int          @map("team_size")
  durationMinutes   Int          @map("duration_minutes")
  sentAt            DateTime     @map("sent_at") @db.Timestamptz(3)
  request           QuoteRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("quotes")
}

/// Mission créée par l'acceptation d'un devis (UC-CL-04, 09, 10).
model Mission {
  id                   String           @id @db.Uuid
  requestId            String           @unique @map("request_id") @db.Uuid
  quoteId              String           @map("quote_id") @db.Uuid
  /// Clé d'idempotence de l'acceptation.
  acceptanceKey        String           @map("acceptance_key")
  customerId           String           @map("customer_id") @db.Uuid
  organizationId       String?          @map("organization_id") @db.Uuid
  status               String
  serviceCode          String           @map("service_code")
  commune              String
  address              String
  /// Position GPS et repère copiés de la demande (ADR-034), pour aller sur place.
  latitude             Float?
  longitude            Float?
  locationAccuracyM    Float?           @map("location_accuracy_m")
  landmark             String?
  /// Groupe et type de lieu de la demande d'origine (ADR-034).
  groupId              String?          @map("group_id") @db.Uuid
  placeType            String?          @map("place_type")
  chosenSlotStart      DateTime         @map("chosen_slot_start") @db.Timestamptz(3)
  chosenSlotEnd        DateTime         @map("chosen_slot_end") @db.Timestamptz(3)
  recurrence           Json?
  plannedInterventions Int              @map("planned_interventions")
  /// Option de paiement choisie par le client : option, timing, method.
  paymentPlan          Json             @map("payment_plan")
  paymentTotal         Int              @map("payment_total")
  depositPercent       Int              @map("deposit_percent")
  depositAmount        Int              @map("deposit_amount")
  cancellationReason   String?          @map("cancellation_reason")
  daysPerWeek          Int?             @map("days_per_week")
  /// Suspension en cours : plus ancienne cause active (unpaid_invoices, unpaid_interventions ou
  /// organization_suspended), null sinon.
  suspensionCause      String?          @map("suspension_cause")
  /// Toutes les causes actives, la plus ancienne d'abord (ADR-030) ; vide sans suspension.
  suspensionCauses     String[]         @default([]) @map("suspension_causes")
  suspendedSince       DateTime?        @map("suspended_since") @db.Timestamptz(3)
  suspensionUnpaid     Int?             @map("suspension_unpaid_count")
  /// Impayés au dernier avertissement envoyé (0 : aucun).
  warningLevel         Int              @default(0) @map("warning_level")
  createdAt            DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @map("updated_at") @db.Timestamptz(3)
  version              Int              @default(0)
  interventions        Intervention[]
  payments             MissionPayment[]

  @@index([customerId, id])
  @@index([status, id])
  @@index([organizationId])
  @@index([groupId])
  @@index([status, updatedAt])
  @@map("missions")
}

/// Passage d'une mission, avec ses propres agents.
model Intervention {
  id                 String    @id @db.Uuid
  missionId          String    @map("mission_id") @db.Uuid
  status             String
  scheduledStart     DateTime  @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd       DateTime  @map("scheduled_end") @db.Timestamptz(3)
  durationMinutes    Int       @map("duration_minutes")
  agentIds           String[]  @map("agent_ids") @db.Uuid
  checklist          Json      @default("[]")
  incidentNote       String?   @map("incident_note")
  /// Références du service file, sans stockage ici.
  beforePhotoFileIds String[]  @default([]) @map("before_photo_file_ids") @db.Uuid
  afterPhotoFileIds  String[]  @default([]) @map("after_photo_file_ids") @db.Uuid
  startedAt          DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  /// suspension (reprogrammable au déblocage) ou manual ; null si le passage n'est pas annulé.
  cancellationCause  String?   @map("cancellation_cause")
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  mission            Mission   @relation(fields: [missionId], references: [id])

  @@index([missionId])
  @@index([scheduledStart, scheduledEnd])
  @@map("interventions")
}

/// Paiement enregistré : coché par le superviseur (espèces, Mobile Money hors ligne) ou, plus tard, en ligne.
model MissionPayment {
  id             String   @id @db.Uuid
  missionId      String   @map("mission_id") @db.Uuid
  amount         Int
  method         String
  reference      String?
  recordedBy     String   @map("recorded_by")
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz(3)
  /// Clé d'idempotence du paiement manuel (en-tête Idempotency-Key), null sans clé.
  idempotencyKey String?  @map("idempotency_key")
  mission        Mission  @relation(fields: [missionId], references: [id])

  @@unique([missionId, idempotencyKey])
  @@index([missionId])
  @@map("mission_payments")
}

/// Agent Nettoyage : compte KSP existant rattaché par l'admin (UC-CL-12).
model Agent {
  userId           String                @id @map("user_id") @db.Uuid
  displayName      String                @map("display_name")
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  unavailabilities AgentUnavailability[]
  teams            TeamMember[]

  @@map("agents")
}

model AgentUnavailability {
  id       String   @id @db.Uuid
  agentId  String   @map("agent_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  reason   String?
  agent    Agent    @relation(fields: [agentId], references: [userId])

  @@index([agentId, startsAt])
  @@map("agent_unavailabilities")
}

model Team {
  id        String       @id @db.Uuid
  name      String
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  members   TeamMember[]

  @@map("teams")
}

model TeamMember {
  teamId  String @map("team_id") @db.Uuid
  agentId String @map("agent_id") @db.Uuid
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agent   Agent  @relation(fields: [agentId], references: [userId])

  @@id([teamId, agentId])
  @@map("team_members")
}

/// Traces locales (prix, devis, affectations, paiements) en attendant le service audit.
model AuditEntry {
  id         String   @id @db.Uuid
  actorId    String   @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  at         DateTime @db.Timestamptz(3)
  details    Json?

  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Factures d'entreprise connues par les événements de billing (overdue, paid) : compte des
/// impayés d'un contrat, indépendant de l'ordre d'arrivée des événements.
model ContractInvoice {
  invoiceId String   @id @map("invoice_id") @db.Uuid
  missionId String   @map("mission_id") @db.Uuid
  /// overdue ou paid ; une facture payée ne redevient jamais impayée.
  status    String
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([missionId, status])
  @@map("contract_invoices")
}

/// Organisations dont KSP a changé l'état, apprises par les événements d'identity (ADR-030) :
/// une organisation suspendue suspend ses missions. Absente : jamais suspendue.
model OrganizationStanding {
  organizationId String   @id @map("organization_id") @db.Uuid
  suspended      Boolean
  /// Date de la dernière décision appliquée (occurredAt) : un événement plus ancien est ignoré.
  changedAt      DateTime @map("changed_at") @db.Timestamptz(3)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("organization_standings")
}

/// Zone desservie : une commune (clé normalisée, la même que les coefficients de commune).
model ServiceZone {
  code      String    @id
  commune   String
  /// Autres noms de la commune, pour rattacher une position géocodée à la zone (ADR-034).
  aliases   String[]  @default([])
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by")
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(3)

  @@map("service_zones")
}

/// Opérations de groupe déjà faites (ADR-035) : idempotence par (auteur, opération, clé) ; le
/// résultat est gardé pour être rejoué à l'identique.
model RequestGroupOperation {
  actorId        String   @map("actor_id") @db.Uuid
  operation      String
  idempotencyKey String   @map("idempotency_key")
  groupId        String   @map("group_id") @db.Uuid
  outcome        Json
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  @@id([actorId, operation, idempotencyKey])
  @@map("request_group_operations")
}
