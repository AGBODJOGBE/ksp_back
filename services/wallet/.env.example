# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=wallet
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50057
HTTP_PORT=3107
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Jeton de service vers payment (ADR-022), obligatoire en production ; vide en local sans vérification.
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=
# Services autorisés à écrire dans le grand livre (ADR-042).
WALLET_LEDGER_CALLERS=recovery
# Portefeuille prépayé (ADR-046) : services qui débitent et remboursent, montants de recharge (XOF).
WALLET_DEBIT_CALLERS=cleaning,billing
WALLET_TOP_UP_MIN=500
WALLET_TOP_UP_MAX=1000000
# Reversements et recharges par payment ; transmission planifiée des reversements en attente (ms, 0 : désactivée).
PAYMENT_GRPC_URL=localhost:50055
WALLET_PAYOUT_SUBMIT_INTERVAL_MS=60000
# Clé de l'empreinte des numéros de bénéficiaire (HMAC, 32 caractères au moins) ; coffre en production (ADR-048).
WALLET_PHONE_HASH_SECRET=
# Rapprochement des débits avec cleaning et billing (ADR-048) : âge minimal (minutes), intervalle (ms, 0 : désactivé).
CLEANING_GRPC_URL=localhost:50053
BILLING_GRPC_URL=localhost:50054
WALLET_DEBIT_CHECK_DELAY_MINUTES=30
WALLET_DEBIT_RECONCILE_INTERVAL_MS=600000
# Crédit manuel (ADR-048) : plafond d'un remboursement et seuil de double validation, en XOF.
WALLET_MANUAL_REFUND_MAX=100000
WALLET_CREDIT_APPROVAL_THRESHOLD=50000
