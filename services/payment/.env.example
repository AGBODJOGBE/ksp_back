# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=payment
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50055
HTTP_PORT=3105
DATABASE_URL=postgresql://payment:payment@localhost:5432/payment
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
# Jeton de service vers cleaning et billing (ADR-022), obligatoire en production ; vide en local sans vérification.
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=
# Montants dus : lus dans cleaning et billing (ADR-031).
CLEANING_GRPC_URL=localhost:50053
BILLING_GRPC_URL=localhost:50054
# Prestataire : simulated en local (page de paiement simulée du portail), fedapay quand les clés existent.
PAYMENT_PROVIDER=simulated
# FedaPay : sandbox ou live ; clé secrète et secret du webhook fournis par le coffre, jamais ici.
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_API_URL=
# Identifiant FedaPay de la devise XOF (currency_id), à relever dans le compte de test ; obligatoire avec fedapay (ADR-031).
FEDAPAY_XOF_CURRENCY_ID=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
# Retour du client après paiement (<adresse>/<id du paiement>) et page de paiement simulée du portail.
PAYMENT_RETURN_URL=http://localhost:3010/mon-espace/paiements
PAYMENT_SIMULATION_CHECKOUT_URL=http://localhost:3010/mon-espace/paiements/simulation
# Expiration d'un paiement en attente (minutes), relecture chez le prestataire (secondes), rapprochement (ms, 0 : désactivé).
PAYMENT_INTENT_TTL_MINUTES=30
PAYMENT_RECHECK_AFTER_SECONDS=10
PAYMENT_RECONCILE_INTERVAL_MS=120000
# Réussite tardive : paiements non aboutis encore relus chez le prestataire pendant ce nombre d'heures.
PAYMENT_LATE_SUCCESS_WINDOW_HOURS=24
# Intervalle entre deux relectures de ces paiements non aboutis (minutes).
PAYMENT_LATE_SUCCESS_RECHECK_MINUTES=15
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
