# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=recovery
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50060
HTTP_PORT=3110
DATABASE_URL=postgresql://recovery:recovery@localhost:5432/recovery
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Jeton de service (ADR-022) : recovery appelle wallet, payment, document, file, notification et identity.
IDENTITY_TOKEN_URL=
SERVICE_CLIENT_SECRET=

# Services appelés (ADR-060).
IDENTITY_GRPC_URL=localhost:50051
NOTIFICATION_GRPC_URL=localhost:50052
PAYMENT_GRPC_URL=localhost:50055
FILE_GRPC_URL=localhost:50056
WALLET_GRPC_URL=localhost:50057
DOCUMENT_GRPC_URL=localhost:50058

# Chiffrement des coordonnées des débiteurs et empreintes de recherche (ADR-063) : deux trousseaux
# distincts, « clé » ou « id:clé,id:clé » en base64 (32 octets, `openssl rand -base64 32`).
# Vides en local : clés temporaires tirées au démarrage (données illisibles après redémarrage).
RECOVERY_PII_ENCRYPTION_KEYS=
RECOVERY_BLIND_INDEX_KEYS=

# Portail : liens « Mon espace ».
PORTAL_BASE_URL=http://localhost:3010
# Lien personnel du débiteur (ADR-061) : page du portail <adresse>/<jeton> (HTTPS en production) et clé
# du HMAC des codes d'accès (32 caractères au moins ; coffre en production, cette valeur y est refusée).
RECOVERY_DEBTOR_BASE_URL=http://localhost:3010/recouvrement
RECOVERY_DEBTOR_CODE_HMAC_SECRET=dev-only-recovery-debtor-code-hmac-secret-0123456789
RECOVERY_GRPC_DEADLINE_MS=3000
# Journal de preuve : PDF long, échéance propre (ADR-060).
RECOVERY_LONG_DOCUMENT_DEADLINE_MS=15000
# Tâche des échéances des dossiers : brouillons non payés, compléments non fournis (0 : désactivée).
RECOVERY_CASE_DEADLINES_INTERVAL_MS=600000
