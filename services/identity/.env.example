# Copier en .env pour le développement local (jamais de vrai secret dans ce fichier).
SERVICE_NAME=identity
NODE_ENV=development
LOG_LEVEL=debug
GRPC_PORT=50051
HTTP_PORT=3101
DATABASE_URL=postgresql://identity:identity@localhost:5432/identity
RABBITMQ_URL=amqp://ksp:ksp@localhost:5672
# Valeur de développement uniquement : en préproduction et en production, elle vient du coffre à secrets.
OTP_HMAC_SECRET=dev-only-otp-hmac-secret-change-me-0123456789
# Règles des codes (valeurs par défaut du cahier des charges, partie 4) :
# OTP_CODE_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_DELAY_SECONDS=60
# OTP_MAX_PER_HOUR=5
# OTP_MAX_PER_DAY=10
# OTP_BLOCK_SECONDS=3600
# Validité du code de confirmation de l'e-mail du profil (15 minutes) :
# EMAIL_OTP_TTL_SECONDS=900
NOTIFICATION_GRPC_URL=localhost:50052
# Clés de signature des jetons (ADR-020). Vide en local : une clé temporaire est générée au démarrage.
# En préproduction et en production, elles viennent du coffre (pnpm --filter @ksp/identity-service keys:generate).
IDENTITY_SIGNING_KEYS=
# ACCESS_TOKEN_TTL_SECONDS=900
# Services autorisés à demander des jetons de service (ADR-022). Vide en local : aucun service ne peut en obtenir.
# Une entrée par service : pnpm --filter @ksp/identity-service keys:service-client <service> <service appelé>…
# Audience geo (service interne, ADR-045) : cleaning aujourd'hui, shop et delivery ensuite.
SERVICE_CLIENTS=
# SERVICE_TOKEN_TTL_SECONDS=300
# Sessions des sites et applications (cahier des charges, partie 4) :
# REFRESH_TOKEN_TTL_SECONDS=2592000
# MAX_SESSIONS=5
# Sessions du back-office (cahier des charges, partie 4) :
# BACKOFFICE_REFRESH_TOKEN_TTL_SECONDS=43200
# BACKOFFICE_MAX_SESSIONS=2
# BACKOFFICE_IDLE_TIMEOUT_SECONDS=1800
# Clé AES-256-GCM des secrets de double authentification (32 octets en base64). Valeur de développement
# uniquement : en production, elle vient du coffre (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Vide : clé temporaire, les applications configurées ne survivent pas au redémarrage.
IDENTITY_MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS1jaGFuZ2UtbWUtMDEyMzQ=
# MFA_TOKEN_TTL_SECONDS=300
# MFA_MAX_ATTEMPTS=5
# Suppression du compte (ADR-036) : délai avant l'anonymisation, services interrogés (nom=hôte:port),
# délai de réponse de chacun, tâche d'anonymisation (0 la désactive), nouveau contrôle d'un report, lot.
# ACCOUNT_DELETION_DELAY_DAYS=30
OBLIGATION_SERVICES=cleaning=localhost:50053,billing=localhost:50054,payment=localhost:50055
# OBLIGATION_CHECK_DEADLINE_MS=1500
# ACCOUNT_DELETION_INTERVAL_MS=900000
# ACCOUNT_DELETION_RECHECK_MINUTES=60
# ACCOUNT_DELETION_BATCH_SIZE=50
# Laisser vide en local tant qu'identity n'émet pas de jetons de service (obligatoire en production).
IDENTITY_JWKS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
