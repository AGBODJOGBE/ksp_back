// Base de données du service identity. Aucun autre service n'y accède (règle d'or n° 1).

generator client {
  provider = "prisma-client-js"
  // Client propre à ce service : plusieurs services cohabitent dans le dépôt.
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Événements à publier (pattern outbox, règle d'or n° 4). Écrits dans la même transaction que la donnée métier.
model OutboxEvent {
  id          String    @id @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)

  @@map("outbox")
}

/// Événements déjà traités par ce service (inbox) : un événement reçu deux fois n'a qu'un effet.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, consumer])
  @@map("processed_events")
}

/// Statut d'un compte (cahier des charges Identité, partie 6).
enum UserStatus {
  pending_verification
  active
  locked
  suspended
  deletion_pending
  deleted
}

enum OtpChannel {
  sms
  whatsapp
}

/// Objet d'un code. D'autres objets (changement de numéro, double authentification…) viendront avec leurs cas d'usage.
enum OtpPurpose {
  login
}

/// Le compte : une personne = un compte.
model User {
  id                  String     @id @db.Uuid
  status              UserStatus
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  preferredLanguage   String     @default("fr") @map("preferred_language")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletionRequestedAt DateTime?  @map("deletion_requested_at") @db.Timestamptz(3)
  anonymizedAt        DateTime?  @map("anonymized_at") @db.Timestamptz(3)
  /// Adresse e-mail en minuscules, enregistrée seulement après confirmation par code ; unique entre comptes.
  email               String?    @unique
  /// Confirmation de l'adresse par le code reçu à cette adresse.
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(3)

  phones             UserPhone[]
  sessions           Session[]
  roleAssignments    RoleAssignment[]
  mfaFactors         MfaFactor[]
  recoveryCodes      MfaRecoveryCode[]
  mfaChallenges      MfaChallenge[]
  emailVerifications EmailVerification[]
  memberships        OrganizationMember[]

  @@map("users")
}

/// Numéros d'un compte. Un numéro n'appartient qu'à un seul compte.
model UserPhone {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  phoneE164  String    @unique @map("phone_e164")
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_phones")
}

/// Codes de vérification envoyés (UC-ID-01). Le code n'est jamais stocké en clair : seulement son HMAC.
model OtpChallenge {
  id           String      @id @db.Uuid
  /// Destinataire au format E.164.
  target       String
  /// Canal demandé.
  channel      OtpChannel
  /// Canal réellement utilisé après une éventuelle bascule ; vide tant que l'envoi n'a pas réussi.
  channelUsed  OtpChannel? @map("channel_used")
  purpose      OtpPurpose
  codeHash     String      @map("code_hash")
  attempts     Int         @default(0)
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime?   @map("consumed_at") @db.Timestamptz(3)
  ip           String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt       DateTime?   @map("sent_at") @db.Timestamptz(3)
  sendFailedAt DateTime?   @map("send_failed_at") @db.Timestamptz(3)

  /// Limites d'envoi par numéro : derniers envois réussis d'une cible.
  @@index([target, sentAt])
  @@map("otp_challenges")
}

/// Type de client qui a ouvert une session : fixe sa durée et le nombre de sessions simultanées.
enum ClientKind {
  web
  mobile
  backoffice
}

/// Une session par appareil (cahier des charges Identité, partie 7).
model Session {
  id           String     @id @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  clientKind   ClientKind @map("client_kind")
  deviceLabel  String?    @map("device_label")
  userAgent    String?    @map("user_agent")
  ip           String?
  /// Organisation active ; vide pour le contexte personnel (UC-ID-15). Relue à chaque renouvellement :
  /// une organisation suspendue ou un membre retiré ramène la session au contexte personnel (ADR-027).
  activeOrgId  String?    @map("active_org_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt   DateTime   @map("last_seen_at") @db.Timestamptz(3)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?    @map("revoke_reason")
  /// Double authentification passée à l'ouverture (back-office) : fixe mfa et auth_time des jetons.
  mfaAt        DateTime?  @map("mfa_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Jetons de renouvellement : seule l'empreinte SHA-256 est conservée ; chaque usage en crée un nouveau.
model RefreshToken {
  id           String    @id @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  issuedAt     DateTime  @map("issued_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Historique des connexions, réussies ou non (UC-ID-21).
model LoginEvent {
  id            String   @id @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  method        String
  success       Boolean
  failureReason String?  @map("failure_reason")
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("login_events")
}

/// Portée d'un rôle ou d'une attribution (cahier des charges Identité, partie 5).
enum RoleScopeType {
  global
  domain
  org
  personal
}

/// Rôles déclarés par les services. Catalogue initial du back-office écrit par la migration 0004.
model Role {
  id               String        @id @db.Uuid
  /// Service qui déclare le rôle.
  service          String
  code             String        @unique
  scopeType        RoleScopeType @map("scope_type")
  requiresMfa      Boolean       @map("requires_mfa")
  /// Donne accès au back-office ; exige alors la double authentification (contrainte en base).
  backofficeAccess Boolean       @default(false) @map("backoffice_access")
  description      String
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  assignments RoleAssignment[]

  @@map("roles")
}

/// Qui a quel rôle, et où. Une attribution retirée garde sa ligne (revoked_at) pour l'historique.
model RoleAssignment {
  id        String        @id @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  roleId    String        @map("role_id") @db.Uuid
  scopeType RoleScopeType @map("scope_type")
  /// Service pour une portée domain, organisation pour une portée org ; vide sinon.
  scopeId   String?       @map("scope_id")
  /// Vide : attribution d'amorçage (script roles:grant).
  grantedBy String?       @map("granted_by") @db.Uuid
  grantedAt DateTime      @map("granted_at") @db.Timestamptz(3)
  revokedAt DateTime?     @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// Une seule attribution active par compte, rôle et portée : index partiel écrit dans la migration.
  @@index([userId, revokedAt])
  @@map("role_assignments")
}

enum MfaFactorType {
  totp
  sms
}

/// Double authentification d'un compte. Le secret est chiffré en AES-256-GCM (clé hors de la base).
model MfaFactor {
  id              String        @id @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  type            MfaFactorType
  secretEncrypted String        @map("secret_encrypted")
  createdAt       DateTime      @map("created_at") @db.Timestamptz(3)
  /// Vide tant que l'enrôlement n'est pas confirmé par un premier code.
  enabledAt       DateTime?     @map("enabled_at") @db.Timestamptz(3)
  /// Dernier pas de temps accepté : un code d'un pas égal ou antérieur est refusé (rejeu).
  lastUsedStep    Int?          @map("last_used_step")
  lastUsedAt      DateTime?     @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factors")
}

/// Codes de récupération à usage unique : seule leur empreinte HMAC est conservée.
model MfaRecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  createdAt DateTime  @map("created_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Étape de double authentification ouverte par un code par téléphone valide (jeton mfa_token).
model MfaChallenge {
  id          String     @id @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  /// Empreinte SHA-256 du jeton remis au client ; le jeton n'est jamais stocké.
  tokenHash   String     @unique @map("token_hash")
  /// Type de client de la connexion : le jeton ne sert qu'à lui.
  clientKind  ClientKind @map("client_kind")
  deviceLabel String?    @map("device_label")
  ip          String?
  attempts    Int        @default(0)
  createdAt   DateTime   @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

/// Codes de confirmation de l'e-mail du profil, envoyés par e-mail. Le code n'est jamais stocké en
/// clair : seulement son HMAC. Seule la dernière demande d'un compte peut être confirmée. Les lignes
/// sont gardées : elles retracent les adresses déclarées, les essais et les confirmations.
model EmailVerification {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// E-mail de facturation d'une organisation (ADR-027) ; vide pour l'e-mail du profil. Les limites
  /// d'envoi (par adresse, par compte) portent sur toutes les demandes, profil et organisations.
  organizationId String?   @map("organization_id") @db.Uuid
  /// Adresse à confirmer, en minuscules.
  email          String
  codeHash       String    @map("code_hash")
  attempts       Int       @default(0)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  ip             String?
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  sendFailedAt   DateTime? @map("send_failed_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  /// Dernière demande d'un compte, et limites d'envoi par compte.
  @@index([userId, sentAt])
  /// Dernière demande d'une organisation.
  @@index([organizationId, createdAt])
  /// Limites d'envoi par adresse.
  @@index([email, sentAt])
  @@map("email_verifications")
}

/// État d'une organisation (ADR-027) : demande en attente, validée, refusée ou suspendue par KSP.
enum OrganizationStatus {
  pending_review
  active
  rejected
  suspended
}

/// Rôle d'un membre dans son organisation (portée org).
enum OrgRole {
  org_admin
  org_member
  org_viewer
}

/// Organisation cliente : compte entreprise (UC-ID-12 à 16, ADR-027). Un IFU n'appartient qu'à une
/// organisation non refusée : index unique partiel écrit dans la migration.
model Organization {
  id                     String             @id @db.Uuid
  /// Raison sociale.
  legalName              String             @map("legal_name")
  address                String
  /// Identifiant fiscal unique (Bénin) : 13 chiffres.
  ifu                    String
  rccm                   String?
  /// E-mail de facturation en minuscules, enregistré seulement après confirmation par code (ADR-026).
  billingEmail           String?            @map("billing_email")
  billingEmailVerifiedAt DateTime?          @map("billing_email_verified_at") @db.Timestamptz(3)
  status                 OrganizationStatus
  createdBy              String             @map("created_by") @db.Uuid
  createdAt              DateTime           @map("created_at") @db.Timestamptz(3)
  /// Admin KSP qui a validé ou refusé la demande.
  reviewedBy             String?            @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason        String?            @map("rejection_reason")
  /// Suspension en cours ; effacée à la réactivation (l'historique est dans audit_log).
  suspendedBy            String?            @map("suspended_by") @db.Uuid
  suspendedAt            DateTime?          @map("suspended_at") @db.Timestamptz(3)
  suspensionReason       String?            @map("suspension_reason")
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  members            OrganizationMember[]
  emailVerifications EmailVerification[]

  /// Liste du back-office : par état, les plus récentes d'abord.
  @@index([status, id])
  /// Demandes en attente d'un compte.
  @@index([createdBy, status])
  @@map("organizations")
}

/// Membres d'une organisation. Un membre retiré garde sa ligne (removed_at) pour l'historique ; une
/// seule appartenance active par compte et organisation : index unique partiel écrit dans la migration.
model OrganizationMember {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           OrgRole
  /// Vide : le créateur de l'organisation.
  addedBy        String?   @map("added_by") @db.Uuid
  joinedAt       DateTime  @map("joined_at") @db.Timestamptz(3)
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, removedAt])
  @@index([organizationId])
  @@map("organization_members")
}

/// Journal des actions du back-office (validation, refus, suspension, réactivation d'une
/// organisation), en attendant le service audit. Écrit dans la transaction de l'action.
model AuditEntry {
  id         String   @id @db.Uuid
  actorId    String   @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  at         DateTime @db.Timestamptz(3)
  details    Json?

  @@index([entityType, entityId])
  @@map("audit_log")
}
