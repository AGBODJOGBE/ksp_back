{
  "name": "@ksp/identity-service",
  "version": "0.1.0",
  "private": true,
  "description": "Service identity de l'écosystème KSP.",
  "main": "dist/main.js",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "dev": "node --watch --env-file=.env -r ../../tools/dev/register.cjs -r ./src/tracing.ts src/main.ts",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "keys:generate": "tsx scripts/generate-signing-key.ts",
    "keys:service-client": "tsx scripts/generate-service-client.ts",
    "roles:grant": "node --env-file-if-exists=.env dist/cli/grant-role.js"
  },
  "dependencies": {
    "@ksp/contracts": "workspace:*",
    "@ksp/platform": "workspace:*",
    "@grpc/grpc-js": "1.14.6",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/microservices": "11.2.7",
    "@prisma/client": "6.19.3",
    "jose": "5.10.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/pg": "8.15.6",
    "pg": "8.16.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
